# ==============================================================================
# Faster FF 08 Gaming Website - Environment Variables
# ==============================================================================
# IMPORTANT:
# 1. Copy this file to .env.local for local development:
#    cp .env.example .env.local
# 2. Never commit .env.local or your real secret keys to Git!
# 3. For Vercel deployment, add these variables in your Vercel Project Settings -> Environment Variables.

# Live Website URL (Used for Canonical URLs, Open Graph, and XML Sitemap)
# Defaults to https://faster-ff-08.vercel.app if not set
NEXT_PUBLIC_SITE_URL=https://faster-ff-08.vercel.app

# Google Search Console Verification Code (Optional: HTML tag method)
# Example: If your meta tag is <meta name="google-site-verification" content="XYZ123" />, paste XYZ123 here:
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Gemini API Key (Server-side ONLY. Do not prefix with NEXT_PUBLIC_)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use (Defaults to gemini-2.5-flash if left blank)
# Recommended options: gemini-2.5-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash
